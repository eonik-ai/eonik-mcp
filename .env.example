# Workspace API key (Settings → API keys) or a session JWT.
# Keys are sent as X-API-Key (and Bearer fallback). Never commit a real key.
EONIK_API_KEY=eonk_live_...

# Production API. Override only for local backend work.
EONIK_API_URL=https://api.eonik.ai

# Optional. Which brand workspace to scope. Omit to use the caller's default brand.
# EONIK_BRAND_ID=
